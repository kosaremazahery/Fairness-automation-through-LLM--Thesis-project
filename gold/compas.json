  "changelog": [
    "1.0-draft (2026-10-24): binary charter/gdpr labels per supervisor guidance.",
    "1.1-draft (2026-10-27): + charter_grounds / gdpr_grounds on sensitive columns; + family on every column; + families table with gdpr_art10 flag.",
    "1.2-draft (2026-11-04): dob question closed (dob gets the same label as age; based on a review of 13 COMPAS sources). No label changed."
  ],
  "data_notes": [
    "Duplicate source columns: decile_score and priors_count appear twice; pandas loads the copies as decile_score.1 and priors_count.1.",
    "The _v1 file ends with 3 junk rows (7217 vs ProPublica's 7214) that hold only decile_score.1 = 4.5096, apparently a leftover mean. run_sweep.py drops rows with fewer than 2 values."
  ],
  "activity_1": {
    "name": "sensitive_features",
    "rule": "Binary. A column is sensitive only if it directly records a ground listed in the legal basis. Indirect revelation (proxies) is step 2. The target is never sensitive.",
    "ground_rule": "Strict scoring: a hit counts only if the model's ground is in the column's <basis>_grounds list. Grounds are written exactly as in activity1.CHARTER_GROUNDS / GDPR_GROUNDS.",
    "bases": {
      "charter": {
        "source": "EU Charter of Fundamental Rights, Art. 21(1) and 21(2)",
        "sensitive": [
          "age",
          "age_cat",
          "dob",
          "race",
          "sex"
        ]
      },
      "gdpr": {
        "source": "GDPR (Regulation (EU) 2016/679), Art. 9(1)",
        "sensitive": [
          "race"
        ]
      }
    },
    "families": {
      "protected": {
        "description": "Directly records a listed ground.",
        "gdpr_art10": false
      },
      "name": {
        "description": "Personal names (candidate ethnicity proxy, step 2).",
        "gdpr_art10": false
      },
      "identifier": {
        "description": "Row and case identifiers.",
        "gdpr_art10": false
      },
      "criminal_history": {
        "description": "Counts of prior offences (adult and juvenile).",
        "gdpr_art10": true
      },
      "current_charge": {
        "description": "Degree and description of the charge at screening.",
        "gdpr_art10": true
      },
      "recidivism_outcome": {
        "description": "Re-offence records and survival fields recorded after screening.",
        "gdpr_art10": true
      },
      "risk_score": {
        "description": "COMPAS model outputs and assessment type.",
        "gdpr_art10": false
      },
      "process_date": {
        "description": "Dates and day counts of arrest, jail, custody and screening.",
        "gdpr_art10": false
      },
      "target": {
        "description": "The prediction target (two-year re-arrest).",
        "gdpr_art10": true
      }
    },
    "resolved_questions": [
      "dob (2026-11-04): sensitive under the Charter, as an encoding of age (rule R1); same label as age under every key. Basis: review of 13 COMPAS sources (Literature Notes, 'COMPAS: which columns the literature treats as sensitive')."
    ],
    "open_questions": [
      "race, Charter grounds: accept 'colour' too? Currently race + ethnic or social origin (the column mixes race and ethnicity, e.g. Hispanic).",
      "Family boundaries are a draft annotation, e.g. whether case numbers count as criminal-offence data (gdpr_art10)."
