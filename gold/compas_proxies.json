    "protected_attributes": {
      "race": {
        "primary": "African-American vs Caucasian (rows of other groups left out of this comparison). Same contrast as Ceccon et al. 2025 and as 53 of 59 COMPAS papers in Simson et al. 2024.",
        "secondary": "all 6 race groups, one-vs-rest AUC averaged over groups (macro), all rows"
      },
      "sex": {
        "primary": "Male vs Female, all rows"
      },
      "age": {
        "primary": "under 25 vs 25 and over, all rows (the contrast highlighted by ProPublica)",
        "secondary": "the 3 age_cat groups, one-vs-rest macro AUC"
      }
    },
    "candidate_columns": "Only columns that could be a legitimate model input: gold families 'name', 'criminal_history', 'current_charge'. Excluded by rule: the sensitive columns themselves, the target, re-offence outcomes (recidivism_outcome), COMPAS model outputs (risk_score), identifiers, process dates.",
    "candidate_families": [
      "name",
      "criminal_history",
      "current_charge"
    ],
    "encoding": {
      "numeric": "the value itself, gradient-boosted trees (HistGradientBoostingClassifier, defaults)",
      "categorical (<= 50 distinct values)": "one-hot + logistic regression",
      "text (> 50 distinct values, e.g. names, charge descriptions)": "character 2-4-grams (TF-IDF, char_wb) + logistic regression"
    },
    "max_categories_for_one_hot": 50,
    "validation": "5-fold stratified cross-validation, shuffled, random_state=0; AUC of the out-of-fold predicted probabilities (so high-cardinality columns cannot score by memorising rows)",
